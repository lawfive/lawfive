# Copy to .env and fill in. Used by compose.yaml (and by `pnpm dev` in server/).
# Sign-up, email, maps, address search, weather and webhooks can instead be set by an admin in the
# web app (Settings → Server). One set here is fixed: the web app shows it but can't change it.

# The server image. Leave unset to build from this source (docker compose up -d --build), or use the
# published one: `latest` is the newest release, a version such as 2026.11.13 stays on it, and `edge`
# follows main (lawfive.dev/run/install). A fork's own image is ghcr.io/<owner>/<repo>.
# LAWFIVE_IMAGE=ghcr.io/lawfive/lawfive:latest

# Signs sign-in sessions. At least 32 characters; generate one with: openssl rand -base64 32
AUTH_SECRET=

# The address people and apps use to reach the server.
PUBLIC_URL=http://localhost:3000

# Where the server is published on this machine (compose.yaml), 3000 by default. Behind a proxy on the
# same machine, 127.0.0.1:3000 keeps it off the network. Outside Docker, the port the server listens on.
# PORT=3000

# The address phones use for the API, if it isn't PUBLIC_URL. Most servers leave this unset.
# API_URL=https://api.example.com

# The proxies whose word on the visitor's address is believed (X-Forwarded-For), so limits on wrong
# passwords count each visitor rather than the proxy: addresses and ranges, comma-separated
# (172.18.0.0/16, 10.0.0.5), or private for any private network. Empty, the default, believes none,
# which is right for a server reached directly. Behind Caddy, Traefik, nginx or a tunnel, set it.
# TRUSTED_PROXIES=private

# Behind a second proxy that sets the visitor's address in a header of its own, that header's name:
# CF-Connecting-IP for Cloudflare. Read only from a proxy in TRUSTED_PROXIES.
# TRUSTED_IP_HEADER=

# Who can make an account: open (anyone), approval (anyone, but an admin approves each new account
# before it can be used), or closed (only people an admin invites). Set here, it's fixed; leave it
# unset to choose on the web app's People page (open until then).
# SIGN_UP=open

# Optional: a new server sets up its admin in the web app, with a code from the server's logs (ADM-5).
# Admins, by email, comma-separated: they invite people and approve new accounts in the web app's
# People page, and can make other admins. These addresses can sign up even when SIGN_UP=closed.
# It doesn't skip the setup code: an empty server's first account needs it whatever its address (SEC-8).
ADMIN_EMAILS=

# Email for invitations, approvals and forgotten passwords (optional; without it, admins send
# invitation and password reset links themselves). An SMTP server: smtp://user:password@host:587 (STARTTLS) or smtps://...:465.
# Most email services offer SMTP (Postmark, Resend, Mailgun, Gmail with an app password).
# SMTP_URL=
# MAIL_FROM=LawFive <lawfive@example.com>

# Webhooks (Settings → Webhooks) can't send to private or local addresses (192.168.x.x, 10.x.x.x,
# localhost…), so nobody can use them to reach into the server's network. Allow them when the
# receivers are on your own network.
# WEBHOOK_ALLOW_PRIVATE=true

# Notifications on phones go through LawFive's push relay, as only the app's publisher can reach the
# store apps. It sees no match details. "off" stops them, or give another relay's address.
# PUSH_RELAY_URL=https://push.lawfive.app
# RELAY_KEY=   # only for a server the push relay has given a key (the hosted one, PUSH-7); self-hosted servers leave it unset

# What each account may use (storage, matches, devices, API keys…) is set by plans, in the web app's
# Settings → Server → Plans. This only sets the storage of a new server's first plan, in megabytes;
# unset means no limit. Matches recorded on a watch are never refused.
# ACCOUNT_STORAGE_LIMIT_MB=2048

# Photos on matches, venues and referees are kept in the server's uploads volume (compose.yaml), or
# in an S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, MinIO…) with S3_URL:
# https://ACCESS_KEY:SECRET@host/bucket, adding ?region=… if the host doesn't include it.
# URL-encode the key and secret if they have characters like / or +. Back up whichever you use.
# S3_URL=https://ACCESS_KEY:SECRET@s3.us-east-1.amazonaws.com/my-lawfive-photos
# Outside Docker, the folder photos are kept in (in Docker it's the uploads volume, /data/uploads).
# UPLOADS_DIR=uploads

# The database password (the database only listens inside the compose network).
POSTGRES_PASSWORD=lawfive

# For running the server outside Docker (pnpm dev in server/): the database from
# `docker compose -f compose.yaml -f compose.dev.yaml up -d db`, or your own.
DATABASE_URL=postgres://lawfive:lawfive@localhost:5432/lawfive

# The map: a vector map (a MapLibre style), OpenFreeMap's by default (free, no key, no limits,
# with a dark style for dark mode). Another provider's style, or "off" for the raster tiles below.
# MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
# MAP_STYLE_ATTRIBUTION=<a href="https://openfreemap.org">OpenFreeMap</a> &copy; OpenMapTiles Data from OpenStreetMap

# Raster map tiles: the map when MAP_STYLE_URL=off, and for apps that can't draw vector maps
# (default: OpenStreetMap's, fine for a personal server; a busy server should use a tile
# provider). {z}/{x}/{y} are filled in by the map.
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# Satellite imagery as a second map layer (a Map / Satellite switch on venue maps), which makes
# placing pitches much easier. Providers need a key; for example MapTiler's free tier:
# MAP_SATELLITE_URL=https://api.maptiler.com/maps/satellite/256/{z}/{x}/{y}.jpg?key=YOUR_KEY
# MAP_SATELLITE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# Check the provider's documentation for the exact address and the attribution it requires.

# Address lookup for placing venues on the map: a Nominatim-compatible service, or "off".
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Weather forecasts for matches, from Open-Meteo (open-meteo.com), or "off". The free API needs no
# key and is for non-commercial use, up to 10,000 calls a day; the server stays under
# WEATHER_DAILY_LIMIT. A commercial service needs a paid plan: set WEATHER_URL to
# https://customer-api.open-meteo.com and WEATHER_API_KEY. A self-hosted Open-Meteo works too.
# WEATHER_URL=https://api.open-meteo.com
# WEATHER_API_KEY=
# WEATHER_DAILY_LIMIT=5000
# Past weather for played matches that have none (imported, or entered afterward), from
# Open-Meteo's historical data, or "off". Same key and daily limit; a paid plan uses
# https://customer-archive-api.open-meteo.com.
# WEATHER_HISTORY_URL=https://archive-api.open-meteo.com
