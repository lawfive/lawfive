<?xml version="1.0" encoding="utf-8"?>
<!-- APP-2: the session stays on this phone: a backup restored elsewhere signs in again. SEC-5: so do
     linked watches' sign-ins, which the phone keeps for passing their syncs on (watch-relay.json). FILE-13: files
     kept for matches without signal stay on this phone too (kept-files/). -->
<full-backup-content>
    <exclude domain="file" path="datastore/session.preferences_pb" />
    <exclude domain="file" path="watch-relay.json" />
    <exclude domain="file" path="kept-files/" />
</full-backup-content>
