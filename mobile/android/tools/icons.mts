// WCH-6: the ones the Wear OS app uses, written to wear/src/main/res/drawable too, in Phosphor's bold weight
// as on the Garmin watch (UI-18).
const wear = ["check", "close", "flag", "info", "link", "matches", "pause", "play", "plus", "quick", "settings", "sliders", "sync", "text", "undo", "watch"];
// UI-18: the watch's own, for its menus' rows as the Garmin watch has them; only on the watch.
// Controls (Tap for stoppage) and Permissions in Settings (UI-17, WCH-7).
const wearOnly: Record<string, string> = { alerts: "Vibrate", history: "ClockCounterClockwise", account: "UserCircle", controls: "Hand", permissions: "ShieldCheck" };

const repo = new URL("../../../", import.meta.url).pathname;
const defs = `${repo}web/node_modules/@phosphor-icons/react/dist/defs`;
const out = `${repo}mobile/android/app/src/main/res/drawable`;
const wearOut = `${repo}mobile/android/wear/src/main/res/drawable`;

/** A Phosphor icon's paths in one weight. */
function pathsOf(component: string, weight: "regular" | "bold"): string[] {
    const source = readFileSync(`${defs}/${component}.es.js`, "utf8");
    const next = weight === "bold" ? "duotone" : "thin";
    const part = source.split(new RegExp(`\\[\\s*"${weight}",`))[1]?.split(new RegExp(`\\]\\s*,\\s*\\[\\s*"${next}"`))[0];
    if (!part) {
        throw new Error(`${component}: no ${weight} weight`);
    }
    const elements = [...part.matchAll(/createElement\("(\w+)", \{([^}]*)\}/g)].filter(([, tag]) => tag !== "Fragment" && tag !== "e.Fragment");
    return elements.map(([, tag, attrs]) => {
        if (tag !== "path") {
            throw new Error(`${component}: a ${tag}, not a path`);
        }
        return /d: "([^"]+)"/.exec(attrs)![1];
    });
}

function write(folder: string, name: string, component: string, weight: "regular" | "bold") {
    const file = `ph_${name.replace(/[A-Z]/g, (c) => `_${c.toLowerCase()}`)}.xml`;
    writeFileSync(`${folder}/${file}`, `<?xml version="1.0" encoding="utf-8"?>
<!-- Phosphor ${component} (${weight}), MIT license. Generated by mobile/android/tools/icons.mts. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="256"
    android:viewportHeight="256">
${pathsOf(component, weight).map((d) => `    <path android:fillColor="#FF000000" android:pathData="${d}" />`).join("\n")}
</vector>
`);
}

for (const [name, component] of Object.entries(icons)) {
    write(out, name, component, "regular");
    if (wear.includes(name)) {
        write(wearOut, name, component, "bold");
    }
}
for (const [name, component] of Object.entries(wearOnly)) {
    write(wearOut, name, component, "bold");
}
console.log(`Wrote ${Object.keys(icons).length} icons to ${out}, and ${wear.length + Object.keys(wearOnly).length} to ${wearOut}`);
