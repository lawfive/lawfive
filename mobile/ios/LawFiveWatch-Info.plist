<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>LawFive</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LFServer</key><string>$(LAWFIVE_SERVER)</string>
	<key>LFVersion</key><string>dev</string>
	<key>LFCommit</key><string>unknown</string>
	<!-- WCH-1: inside the iPhone app, but it works without it. -->
	<key>WKCompanionAppBundleIdentifier</key><string>app.lawfive</string>
	<key>WKRunsIndependentlyOfCompanionApp</key><true/>
	<key>WKApplication</key><true/>
	<!-- WCH-5, WCH-7: the match keeps running with the screen off, as a workout. -->
	<key>WKBackgroundModes</key>
	<array><string>workout-processing</string></array>
	<!-- IOS-11: why each is asked for, in the words the questions show. -->
	<key>NSHealthShareUsageDescription</key><string>LawFive reads your heart rate and distance during a match, for its record and your figures.</string>
	<key>NSHealthUpdateUsageDescription</key><string>LawFive saves each match you referee as a soccer workout, with its route.</string>
	<key>NSLocationWhenInUseUsageDescription</key><string>LawFive records where you ran during a match, for its track and heatmap.</string>
	<key>UIAppFonts</key>
	<array>
		<string>barlow_regular.ttf</string>
		<string>barlow_medium.ttf</string>
		<string>barlow_semibold.ttf</string>
		<string>barlow_condensed_bold.ttf</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- WCH-4, as IOS-2: https everywhere, and plain http only for a server on the local network. -->
		<key>NSAllowsLocalNetworking</key><true/>
	</dict>
	<!-- IOS-11: only the system's own encryption (https), as the iPhone's. -->
	<key>ITSAppUsesNonExemptEncryption</key><false/>
</dict>
</plist>
