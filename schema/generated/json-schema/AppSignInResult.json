{
  "$id": "AppSignInResult.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "The session token, sent from then on as Authorization: Bearer <token>."
    },
    "user": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "status": {
          "$ref": "AccountStatus.json"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "token",
    "user"
  ],
  "additionalProperties": false
}
