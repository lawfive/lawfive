{
  "$id": "AssignorCalendarLink.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "The calendar link: https, http, or webcal (read as https)."
    },
    "system": {
      "$ref": "AssignorSystem.json"
    }
  },
  "required": [
    "url",
    "system"
  ],
  "additionalProperties": false
}
