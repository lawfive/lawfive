{
  "$id": "GpsSeries.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "t": {
      "maxItems": 43200,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "description": "Milliseconds after the track's start, always increasing."
    },
    "lat": {
      "maxItems": 43200,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -90,
        "maximum": 90
      }
    },
    "lon": {
      "maxItems": 43200,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -180,
        "maximum": 180
      }
    },
    "accuracyM": {
      "description": "How far off each position may be, in meters, when the source says.",
      "maxItems": 43200,
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      }
    },
    "speedMps": {
      "description": "The speed the watch measured at each position (m/s), when the source records it (TRK-3); null where it didn't, and the speed then comes from the positions.",
      "maxItems": 43200,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "number",
            "minimum": 0
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "required": [
    "t",
    "lat",
    "lon"
  ],
  "additionalProperties": false,
  "description": "Positions in decimal degrees (WGS 84), one per time; leave out samples without a position."
}
