{
  "$id": "NewInvite.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "email": {
      "description": "Who it's for; only this address can use it.",
      "type": "string",
      "maxLength": 254,
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "name": {
      "description": "Their name, to fill in the sign-up form.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "send": {
      "description": "Email it to them (needs email set up on the server, and an email).",
      "type": "boolean"
    },
    "plan": {
      "description": "The plan the account joins (PLAN-5).",
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z0-9-]+$"
    },
    "planDays": {
      "description": "For how many days, then the default plan.",
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    }
  },
  "additionalProperties": false
}
