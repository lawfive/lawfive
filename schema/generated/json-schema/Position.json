{
  "$id": "Position.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    }
  },
  "required": [
    "lat",
    "lon"
  ],
  "additionalProperties": false,
  "description": "GPS position in decimal degrees (WGS 84)."
}
