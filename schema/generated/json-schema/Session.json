{
  "$id": "Session.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "token": {
      "type": "string",
      "description": "The bearer token."
    },
    "expiresAt": {
      "type": "string",
      "description": "90 days after it was last renewed; a session is renewed once a day while it's used."
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "userId",
    "token",
    "expiresAt",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": {},
  "description": "A signed-in device."
}
