              },
              "venue": {
                "type": "string"
              },
              "pitch": {
                "type": "string"
              },
              "games": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "venueId",
              "venue",
              "games"
            ],
            "additionalProperties": false
