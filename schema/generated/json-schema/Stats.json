    "options": {
      "type": "object",
      "properties": {
        "years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "description": "Years with games, newest first, for the When filter."
        },
        "genders": {
          "type": "array",
          "items": {
            "$ref": "Gender.json"
          },
          "description": "Genders your games have."
        },
        "competitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "Id.json"
              },
              "name": {
                "type": "string"
              },
              "season": {
                "type": "string"
              },
              "games": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "games"
            ],
            "additionalProperties": false
          },
          "description": "Competitions with games, most games first."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tags on your games, alphabetically."
        },
        "venues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "Id.json"
              },
              "name": {
                "type": "string"
              },
              "games": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "name",
              "games"
            ],
            "additionalProperties": false
          },
          "description": "Venues with games, most games first."
        }
      },
      "required": [
        "years",
        "genders",
        "competitions",
        "tags",
        "venues"
      ],
      "additionalProperties": false,
      "description": "What the filters can choose from: from all your games, whatever is filtered."
