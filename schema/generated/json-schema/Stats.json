        "games": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Games with a distance."
        },
        "tracked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Of those, games whose distance comes from a track."
        },
        "averageM": {
          "description": "A game's distance (STAT-16): totalM over games, to the meter; the one per-game distance every page shows. Absent without distances.",
          "type": "number",
          "minimum": 0
