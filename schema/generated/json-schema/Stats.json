    "fitness": {
      "type": "object",
      "properties": {
        "games": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "matchId": {
                "$ref": "Id.json"
              },
              "kickoff": {
                "$ref": "Timestamp.json"
              },
              "distanceM": {
                "type": "number"
              },
              "avgBpm": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "maxBpm": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "sprints": {
                "type": "integer",
                "minimum": 0,
