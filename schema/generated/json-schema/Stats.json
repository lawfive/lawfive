        "byRole": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "referee",
                  "assistant",
                  "fourth"
                ]
              },
              "games": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "averageM": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "role",
              "games",
              "averageM"
            ],
            "additionalProperties": false
          }
        },
        "longest": {
          "type": "object",
          "properties": {
            "matchId": {
              "$ref": "Id.json"
            },
            "kickoff": {
              "$ref": "Timestamp.json"
            },
            "title": {
              "type": "string",
              "description": "Home v Away, or the match's name."
            },
            "role": {
              "$ref": "Role.json"
            },
            "distanceM": {
              "type": "number"
            }
          },
          "required": [
            "matchId",
            "kickoff",
            "title",
            "distanceM"
          ],
          "additionalProperties": false
        },
        "shortest": {
          "type": "object",
          "properties": {
            "matchId": {
              "$ref": "Id.json"
            },
            "kickoff": {
              "$ref": "Timestamp.json"
            },
            "title": {
              "type": "string",
              "description": "Home v Away, or the match's name."
            },
            "role": {
              "$ref": "Role.json"
            },
            "distanceM": {
              "type": "number"
            }
          },
          "required": [
            "matchId",
            "kickoff",
            "title",
            "distanceM"
          ],
          "additionalProperties": false
        },
        "overTime": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "matchId": {
                "$ref": "Id.json"
              },
              "kickoff": {
                "$ref": "Timestamp.json"
              },
              "distanceM": {
                "type": "number"
              },
              "totalM": {
                "type": "number"
              }
