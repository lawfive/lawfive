          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "referee",
                  "assistant"
                ],
                "description": "Games as referee (and games with no role), or as an assistant; a fourth official's have none."
              },
              "cols": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rows": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "cells": {
                "type": "array",
