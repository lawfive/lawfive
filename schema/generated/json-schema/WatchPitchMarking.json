{
  "$id": "WatchPitchMarking.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matchId": {
      "description": "A planned match's id.",
      "$ref": "Id.json"
    },
    "created": {
      "description": "Or, for a quick match, when it was started on the watch (it has no id until it's uploaded).",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "corners": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "integer",
            "minimum": -90000000,
            "maximum": 90000000
          },
          {
            "type": "integer",
            "minimum": -180000000,
            "maximum": 180000000
          }
        ],
        "items": false,
        "minItems": 2,
        "maxItems": 2
      },
      "description": "[latitude, longitude] in millionths of a degree, as the watch's tracks are: its JSON keeps only six significant figures of a decimal."
    },
    "at": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "When they were marked, in seconds since 1970."
    }
  },
  "required": [
    "corners",
    "at"
  ],
  "additionalProperties": false,
  "description": "A pitch's corners walked on the watch (TRK-13, SYNC-12)."
}
