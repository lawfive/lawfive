            "ids": [
                "VIB-1",
                "VIB-6",
                "UI-12"
            ],
            "steps": [
                {
                    "at": "0:00",
                    "do": [
                        {
                            "kickoff": "home"
                        },
                        "start"
                    ]
                },
                {
                    "at": "44:29",
                    "expect": {
                        "screenOn": false
                    }
                },
                {
                    "at": "44:30",
                    "expect": {
                        "screenOn": true
                    }
                },
                {
                    "at": "45:00",
                    "expect": {
                        "alert": "fullTime",
                        "alerting": true
                    }
                },
                {
                    "at": "45:05",
                    "expect": {
                        "alert": null,
                        "alerting": true
                    }
                },
                {
                    "at": "45:10",
                    "expect": {
                        "alert": "fullTime"
                    }
                },
                {
                    "at": "45:11",
                    "do": "acknowledge",
                    "expect": {
                        "alerting": false
                    }
                },
                {
                    "at": "45:20",
                    "expect": {
                        "alert": null
                    }
                }
            ]
        },
