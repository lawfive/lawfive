                        "stoppageRunning": false,
                        "stoppageMs": 30000,
                        "breakDue": false
                    }
                },
                {
                    "at": "22:20",
                    "expect": {
                        "breakLeftMs": null
                    }
                }
            ]
        },
        {
            "name": "reset when started by mistake: due again, and its stoppage taken back",
            "ids": [
                "TMR-7"
