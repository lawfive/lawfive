                },
                {
                    "at": "24:10",
                    "expect": {
                        "alert": "breakEnd",
                        "breakLeftMs": null
                    }
                },
                {
                    "at": "44:59",
                    "expect": {
                        "alert": null,
                        "breakDue": false
                    }
                },
                {
                    "at": "46:00",
                    "do": "endPeriod"
                },
                {
                    "at": "50:00",
                    "expect": {
                        "breakDueInMs": null
                    }
                },
                {
                    "at": "51:00",
                    "expect": {
                        "breakDue": false,
                        "breakLeftMs": 300000
                    }
                },
                {
                    "at": "56:00",
                    "do": [
                        "endHalftime",
                        "startNextPeriod"
                    ],
                    "expect": {
                        "breakDueInMs": 1290000
                    }
                },
                {
                    "at": "77:29",
                    "expect": {
                        "alert": null,
                        "breakDue": false
                    }
                },
                {
                    "at": "77:30",
                    "expect": {
                        "alert": "breakStart",
                        "breakDue": true
                    }
                }
