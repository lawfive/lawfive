{
    "$comment": "WCH-2: the halfway break (TMR-7, TMR-12) and the break clock (TMR-4).",
    "match": [
        {
            "name": "due at 21:30, repeating until started, added on as stoppage, over after its length",
            "ids": [
                "TMR-7",
                "TMR-12",
                "VIB-3"
            ],
            "format": {
                "midBreak": true,
                "breakLenSec": 120,
                "trackStoppage": true
            },
            "steps": [
                {
                    "at": "0:00",
                    "do": [
                        {
                            "kickoff": "home"
                        },
                        "start"
                    ]
                },
                {
                    "at": "20:30",
                    "expect": {
                        "breakDueInMs": 60000
                    }
                },
                {
                    "at": "21:29",
                    "expect": {
                        "alert": null,
                        "breakDue": false
                    }
                },
                {
                    "at": "21:30",
                    "expect": {
                        "alert": "breakStart",
                        "breakDue": true
                    }
                },
                {
                    "at": "21:31",
                    "expect": {
                        "alert": null
                    }
                },
                {
                    "at": "21:40",
                    "expect": {
                        "alert": "breakStart"
                    }
                },
                {
                    "at": "22:00",
                    "do": "startBreak",
                    "expect": {
                        "breakStoppageRunning": true,
                        "stoppageRunning": true
                    }
                },
                {
                    "at": "23:00",
                    "expect": {
                        "breakLeftMs": 60000
                    }
                },
                {
                    "at": "24:00",
                    "expect": {
                        "alert": "breakEnd",
                        "breakLeftMs": null,
                        "stoppageRunning": false
                    }
                },
                {
                    "at": "25:00",
                    "expect": {
                        "stoppageMs": 120000
                    }
                }
            ]
        },
        {
            "name": "skipped, none to come",
