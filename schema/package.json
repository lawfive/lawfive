{
  "name": "@lawfive/schema",
  "version": "0.1.0",
  "private": true,
  "description": "LawFive's shared data model: Zod definitions, generated JSON Schema and OpenAPI, examples and misconduct codes.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generate": "./src/generate.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.ts",
    "typecheck": "tsc",
    "test": "tsc && node --test test/*.test.ts && pnpm lint:api",
    "lint:api": "redocly lint generated/openapi.json --format=summary"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.72.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
