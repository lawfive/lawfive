{
  "name": "@lawfive/server",
  "version": "0.1.0",
  "private": true,
  "description": "LawFive's server: the API, accounts and (later) the web UI and background jobs.",
  "type": "module",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --env-file-if-exists=../.env --watch src/main.ts",
    "demo": "node --env-file-if-exists=../.env --watch src/demo.ts",
    "fixtures": "node src/fixtures.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc",
    "test": "tsc && node --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "@lawfive/schema": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.13",
    "nodemailer": "10.3.1",
    "postgres": "3.4.9",
    "read-excel-file": "9.3.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
