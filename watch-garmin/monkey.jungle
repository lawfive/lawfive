project.manifest = manifest.xml

# Explicit paths: by default the compiler scans the whole project folder, which would also pick up
# the simulator test copy in bin/testcopy (see README, Testing in the simulator).
base.sourcePath = source
base.resourcePath = resources

# UI-25: the running screen's time of day in a size for each high-resolution screen (resources/
# has 416 x 416's). Lower-resolution screens use the watch's own smallest font.
round-360x360.resourcePath = $(base.resourcePath);resources-360
round-390x390.resourcePath = $(base.resourcePath);resources-390
round-454x454.resourcePath = $(base.resourcePath);resources-454
venux1.resourcePath = $(base.resourcePath);resources-venux1

# INP-10, DEV-2: a watch without a touchscreen has no swipe to tell from Back, and on Connect IQ 3 often no
# drag events at all, so MatchDelegate's onDrag (annotated drag) is left out of its build.
descentmk2.excludeAnnotations = drag
descentmk2s.excludeAnnotations = drag
fenix5plus.excludeAnnotations = drag
fenix5splus.excludeAnnotations = drag
fenix5xplus.excludeAnnotations = drag
fenix6pro.excludeAnnotations = drag
fenix6spro.excludeAnnotations = drag
fenix6xpro.excludeAnnotations = drag
fr245m.excludeAnnotations = drag
fr255.excludeAnnotations = drag
fr255m.excludeAnnotations = drag
fr255s.excludeAnnotations = drag
fr255sm.excludeAnnotations = drag
fr645m.excludeAnnotations = drag
fr745.excludeAnnotations = drag
fr945.excludeAnnotations = drag
fr945lte.excludeAnnotations = drag
instinct3amoled45mm.excludeAnnotations = drag
instinct3amoled50mm.excludeAnnotations = drag
instinctcrossoveramoled.excludeAnnotations = drag
marqadventurer.excludeAnnotations = drag
marqathlete.excludeAnnotations = drag
marqaviator.excludeAnnotations = drag
marqcaptain.excludeAnnotations = drag
marqcommander.excludeAnnotations = drag
marqdriver.excludeAnnotations = drag
marqexpedition.excludeAnnotations = drag
marqgolfer.excludeAnnotations = drag
# The fēnix 9 Pro 51 mm's 466 round takes the 454's 20 px, and the Venu Sq 2's 320 x 360 the 360's 16 px,
# by its height.
round-466x466.resourcePath = $(base.resourcePath);resources-454
venusq2.resourcePath = $(base.resourcePath);resources-360
venusq2m.resourcePath = $(base.resourcePath);resources-360

# UI-14: the app icon drawn at the size each watch's app list shows it (launcherIcon in its device
# profile), by web/scripts/icons.ts. A watch not named here gets resources/'s SVG, scaled by the compiler.
instinctcrossoveramoled.resourcePath = $(instinctcrossoveramoled.resourcePath);resources-launcher-38
