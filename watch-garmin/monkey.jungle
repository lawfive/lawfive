project.manifest = manifest.xml

# Explicit paths: by default the compiler scans the whole project folder, which would also pick up
# the simulator test copy in bin/testcopy (see README, Testing in the simulator).
base.sourcePath = source
base.resourcePath = resources

# UI-25: the running screen's time of day in a size for each high-resolution screen (resources/
# has 416 x 416's). Lower-resolution screens use the watch's own smallest font.
round-360x360.resourcePath = $(base.resourcePath);resources-360
round-390x390.resourcePath = $(base.resourcePath);resources-390
round-454x454.resourcePath = $(base.resourcePath);resources-454
venux1.resourcePath = $(base.resourcePath);resources-venux1

# UI-14: the app icon drawn at the size each watch's app list shows it (launcherIcon in its device
# profile), by web/scripts/icons.ts. A watch not named here gets resources/'s SVG, scaled by the compiler.
fenix7.resourcePath = $(fenix7.resourcePath);resources-launcher-40
fenix7pro.resourcePath = $(fenix7pro.resourcePath);resources-launcher-40
fenix7pronowifi.resourcePath = $(fenix7pronowifi.resourcePath);resources-launcher-40
fenix7s.resourcePath = $(fenix7s.resourcePath);resources-launcher-40
fenix7spro.resourcePath = $(fenix7spro.resourcePath);resources-launcher-40
fenix7x.resourcePath = $(fenix7x.resourcePath);resources-launcher-40
fenix7xpro.resourcePath = $(fenix7xpro.resourcePath);resources-launcher-40
fenix7xpronowifi.resourcePath = $(fenix7xpronowifi.resourcePath);resources-launcher-40
fenix8solar47mm.resourcePath = $(fenix8solar47mm.resourcePath);resources-launcher-40
fenix8solar51mm.resourcePath = $(fenix8solar51mm.resourcePath);resources-launcher-40
venu441mm.resourcePath = $(venu441mm.resourcePath);resources-launcher-54
epix2.resourcePath = $(epix2.resourcePath);resources-launcher-60
epix2pro42mm.resourcePath = $(epix2pro42mm.resourcePath);resources-launcher-60
epix2pro47mm.resourcePath = $(epix2pro47mm.resourcePath);resources-launcher-60
epix2pro51mm.resourcePath = $(epix2pro51mm.resourcePath);resources-launcher-60
fenix843mm.resourcePath = $(fenix843mm.resourcePath);resources-launcher-60
fr265.resourcePath = $(fr265.resourcePath);resources-launcher-60
fr265s.resourcePath = $(fr265s.resourcePath);resources-launcher-60
venu2s.resourcePath = $(venu2s.resourcePath);resources-launcher-61
fenix847mm.resourcePath = $(fenix847mm.resourcePath);resources-launcher-65
fenix8pro47mm.resourcePath = $(fenix8pro47mm.resourcePath);resources-launcher-65
fr965.resourcePath = $(fr965.resourcePath);resources-launcher-65
venu445mm.resourcePath = $(venu445mm.resourcePath);resources-launcher-65
venux1.resourcePath = $(venux1.resourcePath);resources-launcher-65
venu2.resourcePath = $(venu2.resourcePath);resources-launcher-70
venu2plus.resourcePath = $(venu2plus.resourcePath);resources-launcher-70
