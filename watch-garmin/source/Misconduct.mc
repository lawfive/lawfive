//! Generated by schema/scripts/generate.ts from schema/misconduct/*.json (EVT-14): don't edit; run pnpm generate.

import Toybox.Lang;

//! EVT-14: the scheme a match's card reasons are listed from: the one given when the watch knows it, else IFAB's.
function misconductScheme(scheme as String?) as String {
    if (scheme != null && (scheme.equals("fa") || scheme.equals("ifab") || scheme.equals("ussf"))) {
        return scheme;
    }
    return "ifab";
}

//! EVT-14: a scheme's codes for a caution (sendOff false) or a send-off (true; without the second caution's),
//! as code and meaning in turn: ["UB", "Unsporting behavior", "DT", "Dissent", ...].
function misconductCodes(scheme as String, sendOff as Boolean) as Array<String> {
    if (scheme.equals("fa")) {
        return (sendOff
            ? ["S1", "Serious foul play", "S2", "Violent conduct", "S3", "Spitting", "S4", "DOGSO by handball", "S5", "DOGSO by foul", "S6", "Abusive language"]
            : ["C1", "Unsporting behavior", "C2", "Dissent", "C3", "Persistent fouling", "C4", "Delaying restart", "C5", "Distance at restart", "C6", "Entered field", "C7", "Left field"]) as Array<String>;
    }
    if (scheme.equals("ussf")) {
        return (sendOff
            ? ["SFP", "Serious foul play", "VC", "Violent conduct", "S", "Spitting", "DGH", "DOGSO by handball", "DGF", "DOGSO by foul", "AL", "Abusive language"]
            : ["UB", "Unsporting behavior", "DT", "Dissent", "PI", "Persistent fouling", "DR", "Delaying restart", "FRD", "Distance at restart", "ERL", "Entered or left field"]) as Array<String>;
    }
    return (sendOff
        ? ["SFP", "Serious foul play", "VC", "Violent conduct", "S", "Spitting or biting", "DOGSO-H", "DOGSO by handball", "DOGSO-F", "DOGSO by foul", "OFFINABUS", "Abusive language"]
        : ["UB", "Unsporting behavior", "DT", "Dissent", "PI", "Persistent fouling", "DR", "Delaying restart", "FRD", "Distance at restart", "E", "Entered field", "L", "Left field"]) as Array<String>;
}
