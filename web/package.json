{
  "name": "@lawfive/web",
  "version": "0.1.0",
  "private": true,
  "description": "LawFive's web UI: React, served by the server.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "typecheck": "tsc",
    "test": "tsc && node --test test/*.test.ts",
    "screenshots": "node scripts/screenshots.ts",
    "site-screenshots": "node scripts/site-screenshots.ts",
    "icons": "node scripts/icons.ts",
    "examples": "node scripts/examples.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lawfive/schema": "workspace:*",
    "@maplibre/maplibre-gl-leaflet": "0.1.4",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-query": "5.104.2",
    "fit-file-parser": "6.2.2",
    "leaflet": "1.9.4",
    "maplibre-gl": "6.16.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0",
    "uqr": "0.1.2",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
